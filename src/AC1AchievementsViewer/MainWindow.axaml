<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AC1AchievementsViewer.MainWindow"
        Title="AC1 Achievements Viewer"
        Width="900" Height="760" MinWidth="640" MinHeight="400">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="SaveCombo" Width="330" PlaceholderText="No saves found"
                          SelectionChanged="SaveCombo_SelectionChanged" />
                <Button x:Name="BrowseFolderButton" Content="Browse folder..." Click="BrowseFolderButton_Click" />
                <Button x:Name="OpenSaveButton" Content="Open save..." Click="OpenSaveButton_Click" />
                <ComboBox x:Name="LanguageCombo" Width="130" SelectionChanged="LanguageCombo_SelectionChanged" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="StatusLine" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl x:Name="AchievementList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" Background="#22FFFFFF">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Width="64" Height="64" Margin="0,0,12,0"
                                       Source="{Binding Picture}" Opacity="{Binding PictureOpacity}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.8" TextWrapping="Wrap" />
                                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                                                 IsVisible="{Binding HasProgress}" Height="10" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding HasProgressText}"
                                               FontSize="12" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                            MinWidth="80">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding GamerscoreText}" Opacity="0.7" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
